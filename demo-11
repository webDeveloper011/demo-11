
import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.util.Random;
import java.util.ArrayList;

public class BubbleGame extends JPanel implements ActionListener, MouseListener {

    Timer timer;
    Random random = new Random();

    ArrayList<Bubble> bubbles = new ArrayList<>();

    int score = 0;
    int missed = 0;

    public BubbleGame() {
        setBackground(Color.BLACK);
        addMouseListener(this);

        timer = new Timer(30, this);
        timer.start();
    }

    class Bubble {
        int x, y, size, speed;
        Color color;

        Bubble(int x, int y) {
            this.x = x;
            this.y = y;
            size = 30 + random.nextInt(40);
            speed = 1 + random.nextInt(3);

            color = new Color(
                random.nextInt(256),
                random.nextInt(256),
                random.nextInt(256)
            );
        }
    }

    public void paintComponent(Graphics g) {
        super.paintComponent(g);

        g.setColor(Color.WHITE);
        g.setFont(new Font("Arial", Font.BOLD, 22));

        g.drawString("Bubble Making Game", 250, 30);
        g.drawString("Score: " + score, 20, 30);
        g.drawString("Missed: " + missed, 20, 60);

        for (Bubble b : bubbles) {
            g.setColor(b.color);
            g.fillOval(b.x, b.y, b.size, b.size);

            g.setColor(Color.WHITE);
            g.drawOval(b.x, b.y, b.size, b.size);
        }
    }

    @Override
    public void actionPerformed(ActionEvent e) {

        // Create bubbles randomly
        if (random.nextInt(20) == 0) {
            int x = random.nextInt(Math.max(1, getWidth() - 60));
            bubbles.add(new Bubble(x, getHeight()));
        }

        // Move bubbles upward
        for (int i = bubbles.size() - 1; i >= 0; i--) {
            Bubble b = bubbles.get(i);
            b.y -= b.speed;

            if (b.y + b.size < 0) {
                bubbles.remove(i);
                missed++;
            }
        }

        repaint();

        // Game over
        if (missed >= 10) {
            timer.stop();

            int option = JOptionPane.showConfirmDialog(
                this,
                "Game Over!\nYour Score: " + score +
                "\nPlay Again?",
                "Game Over",
                JOptionPane.YES_NO_OPTION
            );

            if (option == JOptionPane.YES_OPTION) {
                score = 0;
                missed = 0;
                bubbles.clear();
                timer.start();
            } else {
                System.exit(0);
            }
        }
    }

    @Override
    public void mouseClicked(MouseEvent e) {

        for (int i = bubbles.size() - 1; i >= 0; i--) {
            Bubble b = bubbles.get(i);

            if (e.getX() >= b.x &&
                e.getX() <= b.x + b.size &&
                e.getY() >= b.y &&
                e.getY() <= b.y + b.size) {

                bubbles.remove(i);
                score += 10;
                break;
            }
        }

        repaint();
    }

    public void mousePressed(MouseEvent e) {}
    public void mouseReleased(MouseEvent e) {}
    public void mouseEntered(MouseEvent e) {}
    public void mouseExited(MouseEvent e) {}

    public static void main(String[] args) {

        JFrame frame = new JFrame("Bubble Making Game");

        BubbleGame game = new BubbleGame();

        frame.add(game);
        frame.setSize(700, 600);
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setLocationRelativeTo(null);
        frame.setVisible(true);
    }
}
